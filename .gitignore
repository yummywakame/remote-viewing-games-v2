# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# Static TTS audio cache — regenerate with: npm run audio:sync
# Manifests (manifest.json) are committed; MP3s are not.
public/audio/**/*.mp3

# typescript
*.tsbuildinfo
next-env.d.ts

# IDE settings
.vscode/
